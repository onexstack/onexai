# Kubeconfig for oai-declserver's external webhooks.
#
# The control plane forwards access reviews as Kubernetes native APIs, so the
# cluster.server must be the FULL resource URL — not the host root. Anything
# below the resource path is sent as-is (see
# k8s.io/apiserver/plugin/pkg/authorizer/webhook), which is why a bare
# `https://host:9444` silently posts to `/`.
#
# Use two files (or edit `server` between runs): one for authorization, one for
# authentication.
#
# Authorization:
#   --authorization-mode=Webhook
#   --authorization-webhook-config-file=declserver-sar.kubeconfig
#
# Authentication:
#   --authentication-token-webhook-config-file=declserver-tokenreview.kubeconfig
#
# The target must be HTTPS: client-go never sends kubeconfig credentials to a
# plaintext address, so an http:// server authenticates as nobody and every
# review fails closed.
apiVersion: v1
kind: Config
clusters:
- name: agent
  cluster:
    # Authorization (SubjectAccessReview). For authentication use:
    #   /apis/authentication.k8s.io/v1/tokenreviews
    server: https://oai-agent-apiserver.onexai.svc:9444/apis/authorization.k8s.io/v1/subjectaccessreviews
    # Either point at the serving CA...
    certificateAuthority: /etc/onexai/agent-ca.crt
    # ...or, for a self-signed local deployment only, skip verification:
    # insecure-skip-tls-verify: true
contexts:
- name: agent
  context:
    cluster: agent
    user: agent
current-context: agent
users:
- name: agent
  user:
    # Must match auth.webhook-token in oai-agent-apiserver.yaml.
    token: CHANGE_ME
