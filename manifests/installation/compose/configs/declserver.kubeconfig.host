apiVersion: v1
kind: Config
clusters:
  - name: onexai
    cluster:
      # Host-side copy for kubectl. Apply the optional control-plane fixtures
      # with: kubectl --kubeconfig manifests/installation/compose/configs/declserver.kubeconfig.host apply -f manifests/installation/compose/seed/
      server: https://127.0.0.1:6444
      insecure-skip-tls-verify: true
contexts:
  - name: onexai
    context:
      cluster: onexai
      user: onexai
current-context: onexai
users:
  - name: onexai
    # The server runs with --anonymous-auth=true, but kubectl treats an empty
    # user as "cannot identify a user" and prompts on stdin. A Basic username
    # of "anonymous" (empty password) keeps it non-interactive; AlwaysAllow
    # ignores the identity.
    user: {username: anonymous}
