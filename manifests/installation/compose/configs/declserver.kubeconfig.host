apiVersion: v1
kind: Config
clusters:
  - name: onexai
    cluster:
      # Host-side copy for kubectl. Apply the optional control-plane fixtures
      # with: kubectl --kubeconfig manifests/installation/compose/configs/declserver.kubeconfig.host apply -f manifests/installation/compose/seed/
      server: https://127.0.0.1:6444
      insecure-skip-tls-verify: true
contexts:
  - name: onexai
    context:
      cluster: onexai
      user: onexai
current-context: onexai
users:
  - name: onexai
    user: {}
