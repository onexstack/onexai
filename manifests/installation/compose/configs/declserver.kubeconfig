apiVersion: v1
kind: Config
clusters:
  - name: onexai
    cluster:
      # Container-to-container address. The declserver serves a self-signed
      # certificate that is regenerated on every start, so verification is
      # skipped here; the port is bound to loopback on the host.
      server: https://oai-declserver:6444
      insecure-skip-tls-verify: true
contexts:
  - name: onexai
    context:
      cluster: onexai
      user: onexai
current-context: onexai
users:
  - name: onexai
    user: {}
