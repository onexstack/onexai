# Copy this file to `env` and fill in the values:
#
#   cp env.example env
#   $EDITOR env
#   docker compose --env-file env up -d --build
#
# `env` is git-ignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# LLM (required for a real /v1/chat/completions answer)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint. The service starts without these, but runs
# fail with "AI engine is not configured".
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Set true when the endpoint is on a private network or loopback, e.g. a local
# Ollama reached through http://host.docker.internal:11434/v1.
LLM_ALLOW_PRIVATE_ENDPOINTS=false

# ---------------------------------------------------------------------------
# JWT signing key (agent + chat must share it)
# ---------------------------------------------------------------------------
# The services refuse an empty or built-in placeholder, and the JWT options
# require 6-32 characters. Leave this empty to use the compose dev default;
# generate a real one for anything shared:
#   openssl rand -hex 32
JWT_KEY=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=onexai
POSTGRES_PASSWORD=onexai
POSTGRES_DB=onexai

# ---------------------------------------------------------------------------
# Caller AK/SK pairs
# ---------------------------------------------------------------------------
# Used by oai-chat-apiserver and oai-job-controller to sign /v1 calls.
# In the default development profile auth.bypass-aksk makes the values
# irrelevant; the secure profile seeds the matching agent.secret rows.
CHAT_AKSK_API_KEY=oai-chat-apiserver
CHAT_AKSK_SECRET=onexai-compose-chat-dev-secret
JOB_AKSK_API_KEY=oai-job-controller
JOB_AKSK_SECRET=onexai-compose-job-dev-secret

# ---------------------------------------------------------------------------
# Auth mode
# ---------------------------------------------------------------------------
# Development (default): unsigned /v1 calls are accepted and OPA authorization
# is off. Bindings are loopback-only.
AUTH_BYPASS_AKSK=true
AUTHZ_ENABLED=false
#
# Secure profile: set both of the following, then start with
#   docker compose --env-file env --profile secure up -d --build
# AUTH_BYPASS_AKSK=false
# AUTHZ_ENABLED=true

# ---------------------------------------------------------------------------
# Lark / Feishu (optional)
# ---------------------------------------------------------------------------
# Without these the chat HTTP surface still starts; the bot does not connect.
LARK_APP_ID=
LARK_APP_SECRET=

# ---------------------------------------------------------------------------
# Host ports (change these if something already listens on the default)
# ---------------------------------------------------------------------------
DECLSERVER_HOST_PORT=6444
AGENT_HOST_PORT=8080
CHAT_HOST_PORT=8082
RUNTIME_HOST_PORT=8090

# ---------------------------------------------------------------------------
# Image tag and base images
# ---------------------------------------------------------------------------
ONEXAI_VERSION=dev

# Optional: point the build at a registry mirror when Docker Hub is not
# reachable. The defaults are the upstream images.
# GO_IMAGE=mirror.example.com/library/golang:1.27.0
# RUNTIME_IMAGE=mirror.example.com/library/debian:bookworm-slim
# The module proxy the builder uses. Empty keeps Go's built-in default.
# GOPROXY=https://goproxy.cn,direct

# Optional: use an etcd image from a reachable registry.
# ETCD_IMAGE=registry.k8s.io/etcd:3.7.0-0

# ---------------------------------------------------------------------------
# Optional: complete replacement configs
# ---------------------------------------------------------------------------
# Each service's config is a Compose config file. Point any of these at an
# absolute path to mount your own file instead of the default in ./configs.
# AGENT_CONFIG_FILE=/absolute/path/oai-agent-apiserver.yaml
# CHAT_CONFIG_FILE=/absolute/path/oai-chat-apiserver.yaml
# CONTROLLER_MANAGER_CONFIG_FILE=/absolute/path/oai-controller-manager.yaml
# JOB_CONTROLLER_CONFIG_FILE=/absolute/path/oai-job-controller.yaml
# JOBSERVER_CONFIG_FILE=/absolute/path/oai-jobserver.yaml
# RUNTIME_CONFIG_FILE=/absolute/path/runtime.json
